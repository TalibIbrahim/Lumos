{
  "name": "lumos",
  "version": "2.1.0",
  "description": "Local-first desktop app for Tuya smart lights with Apple HomeKit",
  "main": "./out/main/index.js",
  "author": "TalibIbrahim",
  "license": "MIT",
  "homepage": "https://github.com/TalibIbrahim/Lumos",
  "repository": {
    "type": "git",
    "url": "https://github.com/TalibIbrahim/Lumos.git"
  },
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint . --ext .js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run",
    "start": "electron-vite preview",
    "dev": "npm run build:media-helper && electron-vite dev",
    "build:media-helper": "node scripts/build-media-helper.js",
    "build": "npm run typecheck && npm run build:media-helper && electron-vite build",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^3.0.0",
    "@stablelib/chacha20poly1305": "^2.0.1",
    "electron-updater": "^6.8.9",
    "hap-nodejs": "^0.14.3",
    "qrcode": "^1.5.4",
    "tuyapi": "^7.6.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@fontsource/outfit": "^5.3.0",
    "@tailwindcss/vite": "^4.0.6",
    "@types/node": "^22.13.4",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^4.3.4",
    "clsx": "^2.1.1",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.0.0",
    "framer-motion": "^12.4.7",
    "lucide-react": "^0.475.0",
    "png-to-ico": "^3.0.2",
    "png2icons": "^2.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.0.1",
    "tailwindcss": "^4.0.6",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^5.0.3"
  }
}
